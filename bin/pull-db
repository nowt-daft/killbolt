#!/usr/bin/env bash

source $BASHSTRAP
include print
include prompt

if [ -z $SSH_INSTALLED ]; then
	print::hr
	print::info "[SSH NOT INSTALLED] Please run ./INSTALL_KEY first."
	exit
fi

if prompt::confirm "Do you need to update DATABASE values?"; then
	setup-db
	set-env
else
	print::ok "MOVING ON..."
fi

DUMP_FILE=$MYSQL_DATABASE.sql
DUMP_TARGET="database/initdb.d/$DUMP_FILE"

print::hr =
println "PULLING DATABASE FILE"
println $PRODUCTION_URL
print::key-value "TARGET $DUMP_TARGET"
print::hr

print::info GENERATE SQL DUMP FILE ON SERVER:
print::hr

if [ -f $ROOT/$DUMP_TARGET ]; then
	print::warning "[INITIAL] REMOVING $DUMP_TARGET"
	rm -f $ROOT/$DUMP_TARGET
fi

if ! ssh $(basename $ROOT) "\
	cd $SSH_PATH; \
	rm -f $DUMP_TARGET; \
	mysqldump \
	-u $MYSQL_USER \
	-p\"$MYSQL_PASSWORD\" \
	$MYSQL_DATABASE \
	> $DUMP_TARGET && \
	echo DONE.
"; then
	print::error "[FAIL] Failed to connect to $PRODUCTION_URL"
	exit 1
fi

if ! wget \
	-O $ROOT/$DUMP_TARGET \
	"$PRODUCTION_URL/$DUMP_TARGET" \
	--no-check-certificate; then
	print::error "[FAIL] Failed to download file from server"
	exit 2
fi

print::ok "[SUCCESS] Exported and downloaded $DUMP_FILE"

import-db $ROOT/$DUMP_TARGET --no-prompt
