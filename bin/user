#!/usr/bin/env bash

source $BASHSTRAP
include print
include prompt

GIT_USER=$(git config --get user.name)
GIT_EMAIL=$(git config --get user.email)

if [ -z $GIT_USER ]; then
	print::hr
	GIT_USER=$(prompt::input "[GIT] User")
	git config user.name $GIT_USER
fi
if [ -z $GIT_EMAIL ]; then
	print::hr
	GIT_USER=$(prompt::input "[GIT] E-mail")
	git config user.email $GIT_EMAIL
fi

print::hr
print::key-value "USER" $GIT_USER
print::key-value "EMAIL" $GIT_EMAIL
print::hr
print::done
