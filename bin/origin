#!/usr/bin/env bash

source $BASHSTRAP
include print
include prompt

ORIGIN=$(git config --get remote.origin.url)

if [ -z $ORIGIN ]; then
	print::hr
	ORIGIN=$(prompt::input::type "URL" "[GIT] Remote Origin")
	git remote add origin $ORIGIN
	if [[ $ORIGIN == *github.com* ]]; then
		git branch -M main
		git add .
		git commit -m "@INIT"
		git push -u origin main
	fi
fi

print::hr
print::key-value "ORIGIN" "$ORIGIN"
print::hr
print::done

